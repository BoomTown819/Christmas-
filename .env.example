# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The public "anon" key. Safe in the browser: row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Your site's public address (used for link previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI product descriptions (server only, never sent to the browser) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_BASE_URL=   # optional proxy

# --- Paste-a-link product lookup (optional) ---
# Pages that need JavaScript are read through Microlink's free tier. Set to "off" to never use it.
# METADATA_SERVICE=microlink
# MICROLINK_API_KEY=

# --- Backup product reader for stores that block the app (Amazon, Louis Vuitton…) ---
# Free plan: 10,000 lookups a month, no card. Sign up at https://app.diffbot.com/get-started/
# Jina Reader backup for stores that block the app: on by default, no sign-up needed.
# JINA_READER=off
# JINA_API_KEY=
# DIFFBOT_TOKEN=
