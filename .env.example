# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The public "anon" key. Safe in the browser: row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Your site's public address (used for link previews)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI product descriptions (server only, never sent to the browser) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_BASE_URL=   # optional proxy
